### Task 1 — Episode Component with Fallbacks

**File:** `client/src/components/EpisodeItem.jsx`

```jsx
import React from 'react';

export default function EpisodeItem({ episode }) {
  // Task 1: Render nested podcast name, cover image, and comment count with fallbacks
  const podcastName = episode?.podcast?.name || 'Unknown podcast';
  const coverUrl = episode?.podcast?.coverUrl || '/placeholder-cover.png';
  const commentCount = episode?._count?.comments ?? 0;

  return (
    <div className="episode-item">
      <img 
        src={coverUrl} 
        alt={podcastName} 
        className="podcast-cover" 
        onError={(e) => { e.target.src = '/placeholder-cover.png'; }}
      />
      <div className="episode-content">
        <span className="podcast-name">{podcastName}</span>
        <h3 className="episode-title">{episode.title}</h3>
        <p className="episode-summary">{episode.summary}</p>
        <div className="episode-meta">
          <span className="published-date">
            {episode.publishedAt ? new Date(episode.publishedAt).toLocaleDateString() : ''}
          </span>
          <span className="comment-count">💬 {commentCount} comments</span>
        </div>
      </div>
    </div>
  );
}

