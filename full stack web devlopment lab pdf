### Task 2 & Task 3 — Episode List with Search & Pagination Controls

**File:** `client/src/components/EpisodeList.jsx`

```jsx
import React, { useState } from 'react';
import { useQuery } from '@tanstack/react-query';
import { fetchEpisodes } from '../services/episodes.service';
import EpisodeItem from './EpisodeItem';

export default function EpisodeList() {
  const [search, setSearch] = useState('');
  const [page, setPage] = useState(1);

  // Reset page to 1 whenever user updates search query
  const handleSearchChange = (e) => {
    setSearch(e.target.value);
    setPage(1);
  };

  const { data, isLoading, isError, error } = useQuery({
    queryKey: ['episodes', search, page],
    queryFn: () => fetchEpisodes({ search, page }),
    keepPreviousData: true,
  });

  if (isLoading) return <div className="loading">Loading episodes...</div>;
  if (isError) return <div className="error">Error loading episodes: {error.message}</div>;

  const { episodes = [], total = 0, hasMore = false } = data || {};

  return (
    <div className="episode-list-container">
      {/* Search Bar */}
      <div className="search-bar">
        <input
          type="text"
          placeholder="Search episodes by title..."
          value={search}
          onChange={handleSearchChange}
        />
      </div>

      {/* Episode Grid */}
      <div className="episodes-grid">
        {episodes.length > 0 ? (
          episodes.map((episode) => (
            <EpisodeItem key={episode.id} episode={episode} />
          ))
        ) : (
          <p className="no-results">No episodes found matching your search.</p>
        )}
      </div>

      {/* Pagination Controls */}
      <div className="pagination">
        <button
          onClick={() => setPage((prev) => Math.max(prev - 1, 1))}
          disabled={page === 1}
        >
          Previous
        </button>
        <span className="page-indicator">
          Page {page} {total > 0 ? `of ${Math.ceil(total / 8)}` : ''}
        </span>
        <button
          onClick={() => setPage((prev) => prev + 1)}
          disabled={!hasMore}
        >
          Next
        </button>
      </div>
    </div>
  );
}

```

