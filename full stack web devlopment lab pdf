### Task 1 & Task 2 & Task 3 — Backend Implementation

**File:** `server/routes/episodes.js` (or `server/server.js` if routes are handled inline)

```javascript
const express = require('express');
const router = express.Router();
const { PrismaClient } = require('@prisma/client');
const prisma = new PrismaClient();

// GET /api/episodes
router.get('/', async (req, res, next) => {
  try {
    const { search, page = 1 } = req.query;
    const pageNum = parseInt(page, 10) || 1;
    const pageSize = 8;
    const skip = (pageNum - 1) * pageSize;

    // Task 2: Case-insensitive search filter on title
    const where = {};
    if (search && search.trim() !== '') {
      where.title = {
        contains: search.trim(),
        mode: 'insensitive',
      };
    }

    // Task 3: Total count of matching records for pagination meta
    const total = await prisma.episode.count({ where });

    // Task 1 & 3: Nested include and offset pagination query
    const episodes = await prisma.episode.findMany({
      where,
      skip,
      take: pageSize,
      include: {
        podcast: {
          select: {
            name: true,
            coverUrl: true,
          },
        },
        _count: {
          select: {
            comments: true,
          },
        },
      },
      orderBy: {
        publishedAt: 'desc',
      },
    });

    const hasMore = skip + episodes.length < total;

    // Task 3: Required response envelope
    res.json({
      episodes,
      total,
      hasMore,
    });
  } catch (error) {
    next(error);
  }
});

module.exports = router;

```

